<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="vertical"
    android:gravity="center">
    <TextView android:id="@+id/tvDay"
        android:layout_width="36dp" android:layout_height="36dp"
        android:gravity="center" android:textSize="14sp" android:textColor="#FFFFFF"/>
    <View android:id="@+id/viewDot"
        android:layout_width="5dp" android:layout_height="5dp"
        android:background="@drawable/bg_dot" android:visibility="invisible"/>
</LinearLayout>
