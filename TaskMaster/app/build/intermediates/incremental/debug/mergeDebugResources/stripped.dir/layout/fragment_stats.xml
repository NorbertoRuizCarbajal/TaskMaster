<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:text="Estadísticas" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="20dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="24dp">
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#252540" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvTotal" android:text="0" android:textColor="#FFFFFF"
                        android:textSize="32sp" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Total tareas" android:textColor="#9E9EC8" android:textSize="12sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                app:cardBackgroundColor="#252540" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvCompleted" android:text="0" android:textColor="#6C63FF"
                        android:textSize="32sp" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Completadas" android:textColor="#9E9EC8" android:textSize="12sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <TextView android:text="Productividad" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" app:cardBackgroundColor="#252540" app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvProductivityPct" android:text="0%" android:textColor="#6C63FF"
                    android:textSize="40sp" android:textStyle="bold" android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                <ProgressBar android:id="@+id/progressWeekly" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="12dp" android:progress="0" android:max="100"
                    android:progressDrawable="@drawable/progress_bar_custom" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvProductivityLabel" android:text="de tus tareas están completadas"
                    android:textColor="#9E9EC8" android:textSize="13sp" android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:text="Tareas por día" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" app:cardBackgroundColor="#252540" app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <com.github.mikephil.charting.charts.BarChart android:id="@+id/barChart"
                android:layout_width="match_parent" android:layout_height="220dp" android:padding="8dp"/>
        </androidx.cardview.widget.CardView>
        <TextView android:text="Por categoría" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" app:cardBackgroundColor="#252540" app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:id="@+id/layoutCategories" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
